# API Configuration (must match the backend PORT; no trailing slash)
# Relative path: the Vite dev server proxies /api to the backend (see vite.config.js),
# which also makes the app work through a tunnel. Use a full URL only when not using the proxy.
VITE_API_URL=/api/v1
VITE_BASE_URL=http://localhost:8000

# Authentication
VITE_API_TOKEN_KEY=auth_token

# Environment
VITE_ENV=development

# Features/Debugging
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Optional: File upload limits
VITE_MAX_FILE_SIZE=10485760

# Optional: App metadata
VITE_NAME="Hospital Management System"
VITE_VERSION=1.0.0
